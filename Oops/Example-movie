
class Movie:

    def __init__(self, movie_name: str, total_seats: int, ticket_price: int):
        self.movie_name = movie_name
        self.total_seats = total_seats
        self.ticket_price = ticket_price
        self.booked_seats = 0

    def book_ticket(self, num_tickets):

        available_seats = self.total_seats - self.booked_seats

        if num_tickets <= 0:
            print("Please enter valid number of tickets")

        elif num_tickets > available_seats:
            print("Sorry, not enough seats available")

        else:
            self.booked_seats += num_tickets

            total_amount = self.ticket_price * num_tickets

            print("Your ticket is booked successfully!")
            print(f"Total amount: Rs. {total_amount}")

    def show_status(self):

        available_seats = self.total_seats - self.booked_seats

        print("\n----- Movie Status -----")
        print(f"Movie Name: {self.movie_name}")
        print(f"Total Seats: {self.total_seats}")
        print(f"Available Seats: {available_seats}")
        print(f"Booked Seats: {self.booked_seats}")


m = Movie("Kantara", 100, 499)

m.show_status()

m.book_ticket(10)
m.show_status()

m.book_ticket(89)
m.show_status()

m.book_ticket(8)
m.show_status()